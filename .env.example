# Copy to .env for local dev. Never commit real values.

# --- API ---
CONTENT_DB_PATH=./data/content.sqlite
API_WORKERS=4
API_PORT=8080

# --- Web build (public configuration, not a credential) ---
# Create apps/web/.env.local for local Vite builds. The Dropbox app must use App Folder access.
VITE_DROPBOX_APP_KEY=
# M9.2 AI study Assistant (OpenRouter, user-supplied key, plan/interactive_chat_plan.md).
# Off by default; only "true" turns it on. Keep off in production until M9.3 exits — M9.2's
# Assistant is deliberately ungrounded, which the plan explicitly says must not ship.
VITE_CHAT_ENABLED=

# --- Deploy ---
# These are SENSITIVE. Do NOT put real values here or anywhere in the repo.
# Set them as GitHub Actions repo secrets (Settings → Secrets and variables → Actions):
#   VM_HOST         target VM address
#   VM_USER         deploy user
#   DEPLOY_DIR      compose dir on the VM (e.g. /opt/bible_app)
#   SSH_DEPLOY_KEY  private deploy key (secret only, never committed)
# Image is published to GHCR at ghcr.io/<owner>/<repo>.
