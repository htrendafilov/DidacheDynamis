    "transliteration": "a",
    "work_id": "strongsgreek"
  },
  "strong_g1722_en": {
    "definition": "a primary preposition denoting (fixed) position (in place, time or state), and (by implication) instrumentality (medially or constructively), i.e. a relation of rest (intermediate between 1519 and 1537); \"in,\" at, (up-)on, by, etc.:--about, after, against.\nsee GREEK for 1519",
    "language": "grc",
    "lemma": "ἐν",
    "pronunciation": "en",
    "see": [
