# Python
__pycache__/
*.py[cod]
.venv/
venv/
.env
.pytest_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# Node
node_modules/
apps/web/dist/
*.local
.vite/

# OS / editors
.DS_Store
.idea/
.vscode/

# Build artifacts / data
# content.sqlite is a BUILD ARTIFACT rebuilt from data/sources by the importer
# (locally and in the Docker build) — do not commit it.
data/content.sqlite
data/*.diagnostics.json
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Public-domain sources ARE committed (see data/sources/README.md); owner-provided/licensed
# texts must not be — keep those out with a *.private.* suffix.
data/sources/*.private.*
# CrossWire KJV is fetched from a checksum-pinned official archive during the build. The generated
# IMP export is never committed to the public DidacheDynamis repository.
data/sources/KJV.imp.gz

# Session handoff artifacts (local only)
.continues-handoff.md
*-handoff.md
.kilo/
.claude/
.ua/

# uv is not the documented install path (pip + pyproject is); ignore its lockfiles until adopted
uv.lock

# Private operations runbook — intentionally not committed/published.
# See plan/deployment/README.md.
plan/deployment/live-runbook.md

# Local release driver — drives production from a workstation that holds the SSH
# access and secret-store configuration, so it is intentionally not committed.
scripts/release.sh

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/playwright/.cache/
