# Build artifacts / data
# content.sqlite is a BUILD ARTIFACT rebuilt from data/sources by the importer
# (locally and in the Docker build) — do not commit it.
data/content.sqlite
*.sqlite
*.sqlite-wal
*.sqlite-shm
# Public-domain sources ARE committed (see data/sources/README.md); owner-provided/licensed
# texts must not be — keep those out with a *.private.* suffix.
data/sources/*.private.*

# Session handoff artifacts (local only)
.continues-handoff.md
*-handoff.md

# Playwright
apps/web/test-results/
apps/web/playwright-report/
apps/web/playwright/.cache/
